# Ocechain frontend (Vercel / local Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-facing API origin (no trailing slash).
# Local backend:
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
# Production via same-origin proxy (recommended on HTTPS Vercel — avoids mixed content):
#   NEXT_PUBLIC_API_BASE=/ocechain-api
# Direct to VPS (HTTP; may be blocked as mixed content from HTTPS pages):
#   NEXT_PUBLIC_API_BASE=http://185.249.72.134:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Server-only: where /ocechain-api/* is rewritten (Vercel / next.config.mjs).
# Not exposed to the browser.
API_PROXY_TARGET=http://185.249.72.134:8000

# Optional explicit WebSocket URL when REST uses the /ocechain-api proxy.
# From an HTTPS site this must be wss:// (requires TLS on the VPS) or the browser will block it.
# NEXT_PUBLIC_WS_URL=ws://185.249.72.134:8000/ws

NEXT_PUBLIC_ENTERPRISE_EMAIL=enterprise@ocechain.com
