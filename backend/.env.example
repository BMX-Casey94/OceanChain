AISSTREAM_API_KEY=your_aisstream_key
BSV_PRIVATE_KEY_WIF=your_funded_wallet_wif
TAAL_API_KEY=your_taal_arc_key
DATABASE_URL=postgresql://oceanchain:change_me@YOUR_VPS_IP:5432/oceanchain
BSV_NETWORK=main
UTXO_POOL_TARGET=500
UTXO_VALUE_EACH=10000
# Set to 1 to run one fan-out from the wallet when the pool is empty at startup (optional).
UTXO_AUTO_REFILL_ON_START=0
BATCH_INTERVAL_SECONDS=10
MIN_CHANGE_OUTPUT_SAT=1
VPS_API_PORT=8000
