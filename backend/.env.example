AISSTREAM_API_KEY=your_aisstream_key
# Phase 1 (optional): comma-separated AISStream FilterMessageTypes — Class B + long-range positions merge into the same MMSI snapshot (no extra txs vs PositionReport-only).
# Default is PositionReport only (lowest ingress). Enable when ready to monitor WebSocket load:
# AISSTREAM_FILTER_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,LongRangeAisBroadcastMessage
BSV_PRIVATE_KEY_WIF=your_funded_wallet_wif
TAAL_API_KEY=your_taal_arc_key
# Optional override. Defaults to GorillaPool Arcade in code.
# GORILLA_ARC_URL=https://arcade.gorillapool.io/tx
# Gorilla payload format sent in `rawTx`: raw (standard tx hex), ef (BIP-239 TEF), auto (prefer ef when available).
# Set to `ef` while validating GorillaPool's "PreviousTx not supplied" issue.
# GORILLA_TX_FORMAT=raw
DATABASE_URL=postgresql://oceanchain:change_me@YOUR_VPS_IP:5432/oceanchain
# asyncpg connection pool sizing. Each slot = one Postgres backend process running queries.
# At high BROADCAST_CONCURRENCY, 20 slots can saturate a 4-core VPS. 3-5 is typically plenty.
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=5
BSV_NETWORK=main
# Pool size × value_each = rough sat lock for fan-out (plus fan-out tx fee from wallet).
# Example: 800 × 3000 = 2.4M sat; 10000 sat/UTXO was conservative — typical spends need << 1000 sat.
# Production note: 200 sat pool outputs dust out after only a few chained spends at ~34 sat fees.
# Keep UTXO_VALUE_EACH comfortably above the minimum viable value unless you are only diagnosing.
UTXO_POOL_TARGET=800
UTXO_VALUE_EACH=3000
# Seconds to wait after a failed auto fan-out before retrying (stops ERROR spam). 0 = retry every minute.
REFILL_FAILURE_COOLDOWN_SECONDS=900
# Refuse giant fan-out refills that need too many reserve inputs. 0 = disable the cap.
# Large multi-input refills are slow to validate and correlate with poor Arcade propagation.
# FANOUT_MAX_INPUTS=512
# Optional: ignore dust when importing reserves (WOC sync + admin bulk-import). 0 = no floor.
# For high-churn wallets, set this and BITAILS_IMPORT_MIN_SAT high enough to avoid importing 40-50 sat dust.
# RESERVE_MIN_IMPORT_SAT=1000
# Fan-out funding uses internal Postgres `reserve` rows only (POST /utxo/reserve), not WhatsOnChain.
# Set to 1 to run one fan-out from the wallet when the pool is empty at startup (optional).
UTXO_AUTO_REFILL_ON_START=0
BATCH_INTERVAL_SECONDS=10
# Parallel vessel→ARC pipelines per batch (default 250 in code). Lower if ARC/DB show strain.
# BROADCAST_CONCURRENCY=250
# ARC returns many intermediate states (RECEIVED, STORED, etc.). OceanChain now
# polls ARC status until this target is reached before counting a tx as broadcast.
# ARC_WAIT_FOR_STATUS=SEEN_ON_NETWORK
# Diagnostic note: 1s is useful for proving GorillaPool stalls, but too aggressive for normal operation.
# ARC_MAX_TIMEOUT_SECONDS=10
MIN_CHANGE_OUTPUT_SAT=1
VPS_API_PORT=8000
# Comma-separated browser origins allowed to call the public vessel/stats APIs (Ocechain frontend).
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://ocechain.com,https://www.ocechain.com
# Public search rate limit (per client IP).
# VESSEL_SEARCH_RATE_LIMIT=60
# VESSEL_SEARCH_RATE_WINDOW_SECONDS=60
# VESSELS_LIST_DEFAULT_LIMIT=8000
# VESSELS_LIST_MAX_LIMIT=20000
# Optional: long random secret. Required for POST /utxo/sync-reserves-woc (header X-OceanChain-Admin-Key).
# OCEANCHAIN_ADMIN_API_KEY=generate_a_long_random_string
# Bitails → bulk-import script (scripts/import_reserves_bitails.py): P2PKH for the same wallet as BSV_PRIVATE_KEY_WIF.
# OCEANCHAIN_FUNDING_ADDRESS=1YourP2PKHHere
# OCEANCHAIN_API_BASE=http://127.0.0.1:8000
# Optional Bitails paging / rate limits: BITAILS_API_KEY=…  BITAILS_PAGE_SIZE=500  BULK_IMPORT_BATCH_SIZE=5000
# Client-side dust skip before POST (server still applies RESERVE_MIN_IMPORT_SAT): BITAILS_IMPORT_MIN_SAT=1000
# List largest current unspents (Bitails): python scripts/list_largest_bitails_unspents.py --address … --top 30
# Optional: write first successful vessel raw tx hex for WOC POST /tx/decode (scripts/woc_decode_sample.sh)
# LOG_SAMPLE_RAW_TX_PATH=/tmp/oceanchain_sample_tx.hex
# Satoshis per 1000 bytes of the raw signed transaction (default 102.5). Fee is ceil(size/1000 × rate).
FEE_RATE_SAT_PER_KB=102.5
# Optional per-tx floor after sat/kB (default 1). Increase only if you accept a higher effective rate on small txs.
MIN_TX_FEE_SAT=1
# Pool UTXO minimum = ceil(this/1000×FEE_RATE)+MIN_CHANGE. If set too high vs real pool UTXO sizes, spendable_depth hits 0.
VESSEL_TX_FEE_WORST_CASE_BYTES=320
# Second OP_RETURN push: binary (20 bytes, default) or json (UTF-8, readable in explorers; larger tx / fee).
# OP_RETURN_ENCODING=binary
# OP_RETURN_ENCODING=json
# VPS logging: INFO summary every N seconds (0 = off). Per-tx ARC noise → DEBUG unless VERBOSE_ARC_LOGS=1.
LOG_SUMMARY_INTERVAL_SECONDS=120
# VERBOSE_ARC_LOGS=0
# UVICORN_ACCESS_LOG=0
